# Telegram
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# Public app
APP_URL=
NEXT_PUBLIC_API_URL=http://localhost:3001

# API / workers
API_PORT=3001
BOT_PORT=3000
NODE_ENV=development
SESSION_SECRET=
ADMIN_IDS=

# PostgreSQL / cache
DATABASE_URL=
REDIS_URL=

# Optional Supabase adapter (never expose service-role secrets to the browser)
