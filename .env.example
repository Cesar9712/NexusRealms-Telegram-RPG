SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags: internal economy only by default
FEATURE_WEB3=false
FEATURE_REAL_MONEY_WITHDRAWALS=false
FEATURE_PLAYER_MARKET=true
